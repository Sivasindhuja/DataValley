# LLM (canonical: LLM_MODEL fixes LM_MODEL typo)
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
# DB - centralized via app.config.Settings
DATABASE_URL=sqlite:///./data/app.db
# e.g. postgres: DATABASE_URL=postgresql://postgres:postgres@db:5432/support
# RAG - ChromaDB only (single store, no QDRANT/BM25)
CHROMA_PERSIST_DIR=./data/chroma
# Memory cache
REDIS_URL=
# e.g. REDIS_URL=redis://redis:6379/0
# MCP - explicit mode: direct (default) or mcp
ENABLE_MCP=false
MCP_EXECUTION_MODE=direct
# Auth - JWT
JWT_SECRET=dev-secret-change-me-please-use-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Observability
OTEL_ENABLED=true
ENABLE_GUARDRAILS=true
