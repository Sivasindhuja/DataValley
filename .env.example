# LLM
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
# DB - hybrid: sqlite fallback, or postgres when DATABASE_URL=postgresql://...
DATABASE_URL=sqlite:///./data/app.db
# e.g. postgres: DATABASE_URL=postgresql://postgres:postgres@db:5432/support
# RAG - hybrid: BM25 always, + Chroma/Qdrant/Embeddings toggles
CHROMA_PERSIST_DIR=./data/chroma
ENABLE_CHROMA=false
ENABLE_EMBEDDINGS=false
QDRANT_URL=
# e.g. QDRANT_URL=http://qdrant:6333
# Memory cache
REDIS_URL=
# e.g. REDIS_URL=redis://redis:6379/0
# MCP
ENABLE_MCP=false
# set true to route via stdio MCP servers (requires mcp servers running)
# Observability
LANGFUSE_ENABLED=false
OTEL_ENABLED=true
# Guardrails
ENABLE_GUARDRAILS=true
